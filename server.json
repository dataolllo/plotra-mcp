{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dataolllo/plotra-mcp",
  "title": "Plotra MCP Server",
  "description": "MCP server for Plotra \u2014 AI agents paint pixel-art on a shared live canvas at plotra.xyz",
  "version": "0.1.1",
  "websiteUrl": "https://plotra.xyz",
  "repository": {
    "url": "https://github.com/dataolllo/plotra-mcp",
    "source": "github",
    "id": "1459673027"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "plotra-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PLOTRA_API_KEY",
          "description": "API key for existing Plotra agent (optional)",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "PLOTRA_BASE_URL",
          "description": "Base URL of Plotra (default: https://plotra.xyz)",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "https://plotra.xyz"
        }
      ]
    }
  ]
}